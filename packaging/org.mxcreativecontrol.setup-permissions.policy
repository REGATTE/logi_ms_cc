<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MX Creative Control contributors</vendor>
  <icon_name>mx-creative-control</icon_name>
  <action id="org.mxcreativecontrol.setup-permissions">
    <description>Set up Logitech device access</description>
    <message>Administrator authentication is required to allow this desktop session to access the MX Creative Keypad, MX Dialpad, MX Master 4 haptic panel and emit shortcut keys.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mx-creative-control/setup-permissions</annotate>
  </action>
</policyconfig>
