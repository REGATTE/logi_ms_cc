[Unit]
Description=MX Creative Control keypad and tray
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/mx-creative-control/mxcc-worker --gui-command /usr/bin/mx-creative-control
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
